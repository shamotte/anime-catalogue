<Window x:Class="CichyStrzalko.AnimeKatalog.UI.MainWindow"
        x:Name="AnimeCatalogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CichyStrzalko.AnimeKatalog.UI"
        xmlns:viewmodels="clr-namespace:CichyStrzalko.AnimeKatalog.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="Anime Katalog" Height="600" Width="1200">
    <TabControl Name="Zakładki">
        <TabItem Name="Studio" Header ="Studia">
            <!--detail panel containing Studios-->
            <DockPanel>
                <!--TODO:Filters for Studio -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                    <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding StudioFilterText, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right">
                    </TextBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" >
                    <Button Content="Dodaj"
                        Command="{Binding AddStudioCommand}"/>
                    <Button Content="Edytuj" Command="{Binding EditStudioCommand}"/>
                    <Button Content="Usuń" Command="{Binding DeleteStudioCommand}"
                        />
                </StackPanel>
                <!-- Studio -->
                <StackPanel  Orientation="Horizontal">
                    <ListView Name="ListStudio" ItemsSource="{Binding FilteredStudios}" SelectedItem="{Binding Selectedstudio }">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Name}"></GridViewColumn>
                                <GridViewColumn Header="Adres" DisplayMemberBinding="{Binding Address}"></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Orientation="Vertical">
                        <TextBlock>Id</TextBlock>
                        <TextBlock Text="{Binding Selectedstudio.Id}"/>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBlock Text="{Binding Selectedstudio.Name}"/>
                        <TextBlock>Adres</TextBlock>
                        <TextBlock Text="{Binding Selectedstudio.Address}"/>
                    </StackPanel>
                    <!-- Addition-->
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <TextBlock>Dodaj nowe studio</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding NewStudio.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Adres</TextBlock>
                        <TextBox Text="{Binding NewStudio.Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <!-- Edition-->
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <TextBlock>Edytuj studio</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding EditedStudio.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Adres</TextBlock>
                        <TextBox Text="{Binding EditedStudio.Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>
        <TabItem Name="Anime" Header="Anime">

            <!--Master detail panel containing animes and their characters-->
            <DockPanel >
                <!--Filters for Anime -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding AnimeFilterText, UpdateSourceTrigger=PropertyChanged}"> </TextBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" >
                    <!--TODO:ADD FUNCTIONS-->
                    <Button Content="Dodaj"
                            Command="{Binding AddAnimeCommand}"/>
                    <Button Content="Edytuj" Command="{Binding EditAnimeCommand}"/>
                    <Button Content="Usuń" Command="{Binding DeleteAnimeCommand}"/>
                </StackPanel>
                <!-- Anime -->
                <StackPanel  Orientation="Horizontal">
                    <ListView Name="ListAnime" ItemsSource="{Binding FilteredAnimes}"  SelectedItem ="{Binding Selectedanime}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Name}"></GridViewColumn>
                                <GridViewColumn Header="Data premiery" DisplayMemberBinding="{Binding Premiere}"></GridViewColumn>
                                <GridViewColumn Header="Liczba odcinków" DisplayMemberBinding="{Binding Episodes}"></GridViewColumn>
                                <GridViewColumn Header="Gatunki">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Genres}">

                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel>
                        <TextBlock>Id</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.Id}"/>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.Name}"/>
                        <TextBlock>Liczba odcinków</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.Episodes}"/>
                        <TextBlock>Data premiery</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.Premiere}"/>
                        <TextBlock>Studio</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.StudioID}"/>
                        <TextBlock>Gatunki</TextBlock>
                        <TextBlock Text="{Binding Selectedanime.Genres}"/>
                        <Image Source="{Binding Selectedanime.ImageData, Converter={StaticResource ByteArrayToImage}, TargetNullValue={StaticResource Placeholder}}"  Height="200" Margin="0,10,0,0"/> 
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <!-- Addition Anime-->
                        <TextBlock>Dodaj nowe anime</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding NewAnime.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Liczba odcinków</TextBlock>
                        <TextBox Text="{Binding NewAnime.Episodes, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Premiera</TextBlock>
                        <DatePicker SelectedDate="{Binding NewAnime.Premiere}"/>
                        <TextBlock>Twórca</TextBlock>
                        <ComboBox  ItemsSource="{Binding Studios}" SelectedItem="{Binding SelectedStudioForNewAnime}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ListBox ItemsSource="{Binding AddeddGenres}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding SelectedGenre, Converter={StaticResource EnumToNameConverter}}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock>Obrazek</TextBlock>
                        <Image Source="{Binding NewAnime.ImageData, Converter={StaticResource ByteArrayToImage}, TargetNullValue={StaticResource Placeholder}}" Height="100" Margin="0,0,0,0">
                        </Image>
                        <Button Content="Dodaj Obraz" Command="{Binding NewAnime.SetImageCommand}">
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <!-- Edition Anime-->
                        <TextBlock>Edytuj anime</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding EditedAnime.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Liczba odcinków</TextBlock>
                        <TextBox Text="{Binding EditedAnime.Episodes, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Premiera</TextBlock>
                        <DatePicker SelectedDate="{Binding EditedAnime.Premiere}"/>
                        <TextBlock>Twórca</TextBlock>
                        <ComboBox  ItemsSource="{Binding Studios}" SelectedItem="{Binding  SelectedStudioForEditedAnime}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ListBox ItemsSource="{Binding EditedGenres}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding SelectedGenre, Converter={StaticResource EnumToNameConverter}}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock>Obrazek</TextBlock>
                        <!--TODO:IMAGE-->
                        <Image Source="{Binding EditedAnime.ImageData, Converter={StaticResource ByteArrayToImage}, TargetNullValue={StaticResource Placeholder}}"  Height="200" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>
        <TabItem Name="Characters" Header="Postacie">
            <DockPanel >
                <!--Filters for Characters -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding CharactersFilterText, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                </StackPanel>
                <!-- Characters -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" >
                    <Button Content="Dodaj" Command="{Binding AddCharacterCommand}"/>
                    <Button Content="Edytuj"  Command="{Binding EditCharacterCommand}"/>
                    <Button Content="Usuń" Command="{Binding DeleteCharacterCommand}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal">
                    <ListView Name="ListCharacters" ItemsSource="{Binding FilteredCharacters}" SelectedItem="{Binding Selectedcharacter}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Name}"></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel>
                        <TextBlock>Id</TextBlock>
                        <TextBlock Text="{Binding Selectedcharacter.Id}"/>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBlock Text="{Binding Selectedcharacter.Name}"/>
                        <TextBlock>Anime</TextBlock>
                        <TextBlock Text="{Binding Selectedcharacter.AnimeID}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock> Dodaj Nową Postać</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding NewCharacter.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Anime</TextBlock>
                        <ComboBox ItemsSource="{Binding Animes}" SelectedItem="{Binding SelectedAnimeForNewCharacter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Image Source="{Binding NewCharacter.ImageData, Converter={StaticResource ByteArrayToImage}}">
                            <Image.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding NewCharacter.SetImageCommand}"/>
                            </Image.InputBindings>
                        </Image>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock> Edytuj Postać</TextBlock>
                        <TextBlock>Nazwa</TextBlock>
                        <TextBox Text="{Binding EditedCharacter.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock>Anime</TextBlock>
                        <ComboBox ItemsSource="{Binding Animes}" SelectedItem="{Binding SelectedAnimeForEditedCharacter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!--<Image Source="{Binding EditedCharacter.ImageData, Converter={StaticResource ByteArrayToImage}}">
                            <Image.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding EditedCharacter.SetImageCommand}"/>
                            </Image.InputBindings>
                        </Image>-->
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>

    </TabControl>

</Window>
