<Application x:Class="CichyStrzalko.AnimeKatalog.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CichyStrzalko.AnimeKatalog.UI"
             xmlns:converters="clr-namespace:CichyStrzalko.AnimeKatalog.UI.Converters">
    <Application.Resources>
        <converters:ByteArrayToImage x:Key="ByteArrayToImage"/>
        <converters:EnumToNameConverter x:Key="EnumToNameConverter"/>
        <converters:StudioVMToIStudio x:Key="StudioVMToIStudio" />
        <DrawingImage x:Key="Placeholder">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="LightGray">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
